<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!--
    Gantt Studio renderer template.

    Iteration:
      - `visibleRows` is the subset of `allRows` whose y-band is inside the
        scroll viewport (+ buffer). Computed in `_beforeRender()` from
        `useVirtualGrid.rowsIndexes`. The SVG only ever emits DOM nodes for
        these rows, which keeps the tree small even on plans with thousands
        of records.
      - Keys are stable strings (`group_X`, `bar_<id>`) so OWL keeps DOM
        identity across scroll-induced re-renders.
-->
<t t-name="gantt_studio.Renderer">
    <div class="o_gantt_studio_renderer" t-ref="root">
        <div class="o_gs_inner" t-attf-style="width: calc({{leftPanelWidth}}px + {{viewportWidth}}px); height: {{totalHeight}}px;">

            <!-- Left panel -->
            <div class="o_gs_left" t-attf-style="width: {{leftPanelWidth}}px;">
                <div class="o_gs_left_header" t-attf-style="height: {{headerHeight}}px;">
                    <strong>Item</strong>
                </div>
                <t t-foreach="visibleRows" t-as="row" t-key="row.key">
                    <div t-if="row.type === 'group'"
                         class="o_gs_left_row o_gs_group_row"
                         t-attf-style="top: {{rowY(row.rowIdx)}}px; height: {{rowHeight}}px;">
                        <i class="fa fa-folder-open me-2 text-muted"/>
                        <span class="fw-bold" t-esc="row.label"/>
                    </div>
                    <div t-elif="row.type === 'bar'"
                         class="o_gs_left_row"
                         t-attf-style="top: {{rowY(row.rowIdx)}}px; height: {{rowHeight}}px;"
                         t-att-title="row.leftLabel">
                        <span t-esc="row.leftLabel"/>
                    </div>
                </t>
            </div>

            <!-- SVG canvas -->
            <svg class="o_gs_canvas"
                 t-att-width="viewportWidth"
                 t-att-height="totalHeight"
                 t-attf-style="left: {{leftPanelWidth}}px;">

                <!-- Header band -->
                <rect x="0" y="0" t-att-width="viewportWidth" t-att-height="headerHeight"
                      class="o_gs_header_bg"/>
                <g class="o_gs_header_ticks">
                    <g t-foreach="headerTicks" t-as="tick" t-key="tick_index">
                        <line t-att-x1="tick.x" y1="0" t-att-x2="tick.x" t-att-y2="totalHeight"
                              class="o_gs_grid_line"/>
                        <text t-att-x="tick.x + 6" y="24" class="o_gs_header_label"
                              t-esc="tick.label"/>
                    </g>
                </g>

                <!-- Row separators (only for visible rows; off-screen rows
                     would render off-screen lines anyway). -->
                <g class="o_gs_row_separators">
                    <line t-foreach="visibleRows" t-as="row" t-key="'sep_' + row.key"
                          x1="0" t-att-x2="viewportWidth"
                          t-att-y1="rowY(row.rowIdx) + rowHeight"
                          t-att-y2="rowY(row.rowIdx) + rowHeight"
                          class="o_gs_row_sep"/>
                </g>

                <!-- Today line — vertical, spans full height; not affected by
                     row virtualization. -->
                <line t-if="todayLineX !== null"
                      t-att-x1="todayLineX" y1="0"
                      t-att-x2="todayLineX" t-att-y2="totalHeight"
                      class="o_gs_today"/>

                <!-- Baseline ghost bars (behind real bars) -->
                <g class="o_gs_ghosts">
                    <g t-foreach="visibleRows" t-as="row" t-key="'ghost_' + row.key">
                        <rect t-if="row.type === 'bar' and row.ghost"
                              class="o_gs_bar_ghost"
                              t-att-x="row.ghost.x"
                              t-att-y="row.y - 2"
                              t-att-width="row.ghost.width"
                              t-att-height="row.height + 4"
                              rx="6" ry="6"/>
                    </g>
                </g>

                <!-- Dependency arrows.
                     NOTE: arrows are computed against `barGeoById` which is
                     populated from the FULL `allRows` set, not just visible
                     ones, so an arrow whose endpoints are off-screen still
                     renders (and the SVG clips it naturally). Arrows are
                     under bars so the bar rect hides the line where it would
                     cross. -->
                <g class="o_gs_arrows" t-if="props.archInfo.showDependencies">
                    <g t-foreach="arrows" t-as="arrow" t-key="arrow.id"
                       t-att-class="arrow.critical ? 'o_gs_arrow_critical' : ''">
                        <path class="o_gs_arrow_line" t-att-d="arrow.d"/>
                        <polygon class="o_gs_arrow_head" t-att-points="arrow.head"/>
                    </g>
                </g>

                <!-- Bars (only visible rows).
                     Milestones (`isMilestone === true`) draw a diamond at
                     date_start instead of a regular bar with width. -->
                <g class="o_gs_bars">
                    <g t-foreach="visibleRows" t-as="row" t-key="row.key">
                        <g t-if="row.type === 'bar'"
                           class="o_gs_bar_group"
                           t-att-class="(row.critical ? 'o_gs_bar_critical ' : '')
                                        + (state.dragId === row.record.id ? 'o_gs_bar_dragging ' : '')
                                        + (row.dragDisabled ? 'o_gs_bar_locked ' : '')
                                        + (row.isMilestone ? 'o_gs_milestone ' : '')
                                        + row.decorationClasses.join(' ')"
                           t-on-mousedown="(ev) => this.onBarMouseDown(row, ev)"
                           t-on-touchstart="(ev) => this.onBarTouchStart(row, ev)">

                            <!-- Milestone path: diamond at date_start.
                                 Bug fix: aplicar `dragOffsetForBar(row)` via
                                 SVG `transform=translate(dx,0)` para que el
                                 rombo se mueva visualmente durante el drag.
                                 Antes quedaba "anclado" mientras el cursor
                                 sí se desplazaba, lo que confundía al usuario. -->
                            <polygon t-if="row.isMilestone"
                                     class="o_gs_milestone_shape"
                                     t-att-points="row.milestonePoints"
                                     t-att-fill="row.color"
                                     t-att-transform="'translate(' + dragOffsetForBar(row) + ',0)'"/>
                            <text t-if="row.isMilestone"
                                  class="o_gs_bar_label o_gs_bar_label_outside o_gs_milestone_label"
                                  t-att-x="row.x + row.height / 2 + 8 + dragOffsetForBar(row)"
                                  t-att-y="row.y + row.height / 2"
                                  t-esc="row.label"/>

                            <!-- Regular bar path -->
                            <rect t-if="!row.isMilestone"
                                  class="o_gs_bar"
                                  t-att-x="row.x + dragOffsetForBar(row)"
                                  t-att-y="row.y"
                                  t-att-width="row.width"
                                  t-att-height="row.height"
                                  rx="6" ry="6"
                                  t-att-fill="row.color"/>
                            <rect t-if="!row.isMilestone and row.progress !== null"
                                  class="o_gs_bar_progress"
                                  t-att-x="row.x + dragOffsetForBar(row)"
                                  t-att-y="row.y"
                                  t-att-width="row.width * row.progress / 100"
                                  t-att-height="row.height"
                                  rx="6" ry="6"/>
                            <text t-if="!row.isMilestone"
                                  t-att-class="row.labelOutside ? 'o_gs_bar_label o_gs_bar_label_outside' : 'o_gs_bar_label'"
                                  t-att-x="row.labelX + dragOffsetForBar(row)"
                                  t-att-y="row.labelY"
                                  t-esc="row.displayLabel"/>
                            <title t-esc="row.label"/>
                        </g>
                    </g>
                </g>
            </svg>
        </div>
    </div>
</t>

</templates>
