<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!--
    Gantt Studio renderer template.

    Iteration:
      - `visibleRows` is the subset of `allRows` whose y-band is inside the
        scroll viewport (+ buffer). Computed in `_beforeRender()` from
        `useVirtualGrid.rowsIndexes`. The SVG only ever emits DOM nodes for
        these rows, which keeps the tree small even on plans with thousands
        of records.
      - Keys are stable strings (`group_X`, `bar_<id>`) so OWL keeps DOM
        identity across scroll-induced re-renders.
-->
<t t-name="gantt_studio.Renderer">
    <div class="o_gantt_studio_renderer" t-ref="root">
        <div class="o_gs_inner" t-attf-style="width: calc({{leftPanelWidth}}px + {{viewportWidth}}px); height: {{totalHeight}}px;">

            <!-- Left panel -->
            <div class="o_gs_left" t-attf-style="width: {{leftPanelWidth}}px;">
                <div class="o_gs_left_header" t-attf-style="height: {{headerHeight}}px;">
                    <strong>Item</strong>
                </div>
                <t t-foreach="visibleRows" t-as="row" t-key="row.key">
                    <div t-if="row.type === 'group'"
                         class="o_gs_left_row o_gs_group_row"
                         t-attf-style="top: {{rowY(row.rowIdx)}}px; height: {{rowHeight}}px;">
                        <i class="fa fa-folder-open me-2 text-muted"/>
                        <span class="fw-bold" t-esc="row.label"/>
                    </div>
                    <div t-elif="row.type === 'bar'"
                         class="o_gs_left_row"
                         t-att-class="row.isParent ? 'o_gs_left_row_parent' : ''"
                         t-attf-style="top: {{rowY(row.rowIdx)}}px; height: {{rowHeight}}px; padding-left: {{12 + (row.depth || 0) * 16}}px;"
                         t-att-title="row.leftLabel">
                        <!-- Sprint 3.3: chevron de expand/collapse para
                             nodos padre. Click cambia el estado del Set
                             `collapsed`. -->
                        <i t-if="row.isParent"
                           class="o_gs_chevron fa me-1"
                           t-att-class="row.isCollapsed ? 'fa-caret-right' : 'fa-caret-down'"
                           t-on-click="(ev) => this.onToggleCollapse(row, ev)"/>
                        <span t-esc="row.leftLabel"/>
                    </div>
                </t>
            </div>

            <!-- SVG canvas -->
            <svg class="o_gs_canvas"
                 t-att-width="viewportWidth"
                 t-att-height="totalHeight"
                 t-attf-style="left: {{leftPanelWidth}}px;">

                <!-- Header band -->
                <rect x="0" y="0" t-att-width="viewportWidth" t-att-height="headerHeight"
                      class="o_gs_header_bg"/>
                <g class="o_gs_header_ticks">
                    <g t-foreach="headerTicks" t-as="tick" t-key="tick_index">
                        <line t-att-x1="tick.x" y1="0" t-att-x2="tick.x" t-att-y2="totalHeight"
                              class="o_gs_grid_line"/>
                        <text t-att-x="tick.x + 6" y="24" class="o_gs_header_label"
                              t-esc="tick.label"/>
                    </g>
                </g>

                <!-- Row separators (only for visible rows; off-screen rows
                     would render off-screen lines anyway). -->
                <g class="o_gs_row_separators">
                    <line t-foreach="visibleRows" t-as="row" t-key="'sep_' + row.key"
                          x1="0" t-att-x2="viewportWidth"
                          t-att-y1="rowY(row.rowIdx) + rowHeight"
                          t-att-y2="rowY(row.rowIdx) + rowHeight"
                          class="o_gs_row_sep"/>
                </g>

                <!-- Today line — vertical, spans full height; not affected by
                     row virtualization. -->
                <line t-if="todayLineX !== null"
                      t-att-x1="todayLineX" y1="0"
                      t-att-x2="todayLineX" t-att-y2="totalHeight"
                      class="o_gs_today"/>

                <!-- Baseline ghost bars (behind real bars).
                     Sprint 3.7 — Multi-baseline: una capa por cada baseline
                     visible, colorizada con o_gs_bar_ghost_color_N. -->
                <g class="o_gs_ghosts">
                    <g t-foreach="visibleRows" t-as="row" t-key="'ghosts_' + row.key">
                        <g t-if="row.type === 'bar' and row.ghosts"
                           t-foreach="row.ghosts" t-as="gh" t-key="'g_' + row.key + '_' + gh_index">
                            <rect class="o_gs_bar_ghost"
                                  t-att-class="'o_gs_bar_ghost o_gs_bar_ghost_color_' + gh.color"
                                  t-att-x="gh.x"
                                  t-att-y="row.y - 2 + gh.offset"
                                  t-att-width="gh.width"
                                  t-att-height="row.height + 4"
                                  rx="6" ry="6">
                                <title t-esc="gh.baselineName"/>
                            </rect>
                        </g>
                    </g>
                </g>

                <!-- Dependency arrows.
                     NOTE: arrows are computed against `barGeoById` which is
                     populated from the FULL `allRows` set, not just visible
                     ones, so an arrow whose endpoints are off-screen still
                     renders (and the SVG clips it naturally). Arrows are
                     under bars so the bar rect hides the line where it would
                     cross. -->
                <g class="o_gs_arrows" t-if="props.archInfo.showDependencies">
                    <g t-foreach="arrows" t-as="arrow" t-key="arrow.id"
                       t-att-class="arrow.critical ? 'o_gs_arrow_critical' : ''">
                        <path class="o_gs_arrow_line" t-att-d="arrow.d"/>
                        <polygon class="o_gs_arrow_head" t-att-points="arrow.head"/>
                    </g>
                </g>

                <!-- Sprint 3.2.C: línea fantasma durante drag-to-create dep.
                     Va por DEBAJO de los bars (mismo orden que las flechas
                     reales) para que ningún bar intercepte el mouseup. -->
                <g t-if="state.depDragFrom !== null" class="o_gs_dep_ghost">
                    <path class="o_gs_dep_ghost_line" t-att-d="depGhostPath()"/>
                </g>

                <!-- Bars (only visible rows).
                     Milestones (`isMilestone === true`) draw a diamond at
                     date_start instead of a regular bar with width. -->
                <g class="o_gs_bars">
                    <g t-foreach="visibleRows" t-as="row" t-key="row.key">
                        <g t-if="row.type === 'bar'"
                           class="o_gs_bar_group"
                           t-att-data-record-id="row.record.id"
                           t-att-class="(row.critical ? 'o_gs_bar_critical ' : '')
                                        + (state.dragId === row.record.id ? 'o_gs_bar_dragging ' : '')
                                        + (row.dragDisabled ? 'o_gs_bar_locked ' : '')
                                        + (row.isMilestone ? 'o_gs_milestone ' : '')
                                        + (state.editingId === row.record.id ? 'o_gs_bar_editing ' : '')
                                        + (row.overallocated ? 'o_gs_bar_overallocated ' : '')
                                        + row.decorationClasses.join(' ')"
                           t-on-mousedown="(ev) => this.onBarMouseDown(row, ev)"
                           t-on-touchstart="(ev) => this.onBarTouchStart(row, ev)"
                           t-on-dblclick="(ev) => this.onBarDoubleClick(row, ev)">

                            <!-- Milestone path: diamond at date_start.
                                 Bug fix: aplicar `dragOffsetForBar(row)` via
                                 SVG `transform=translate(dx,0)` para que el
                                 rombo se mueva visualmente durante el drag.
                                 Antes quedaba "anclado" mientras el cursor
                                 sí se desplazaba, lo que confundía al usuario. -->
                            <polygon t-if="row.isMilestone"
                                     class="o_gs_milestone_shape"
                                     t-att-points="row.milestonePoints"
                                     t-att-fill="row.color"
                                     t-att-transform="'translate(' + dragOffsetForBar(row) + ',0)'"/>
                            <text t-if="row.isMilestone"
                                  class="o_gs_bar_label o_gs_bar_label_outside o_gs_milestone_label"
                                  t-att-x="row.x + row.height / 2 + 8 + dragOffsetForBar(row)"
                                  t-att-y="row.y + row.height / 2"
                                  t-esc="row.label"/>

                            <!-- Regular bar path.
                                 Sprint 3.2.A: la geometría que se DIBUJA pasa
                                 por `barGeoForRender(row)` que aplica el offset
                                 de resize en curso. El drag entero usa
                                 dragOffsetForBar (que NO interactúa con resize
                                 porque ambos son mutuamente excluyentes).
                                 Sprint 3.3: los padres WBS usan una "summary
                                 bar" más delgada (visualmente distinta) que
                                 representa el envelope de sus hijos. -->
                            <rect t-if="!row.isMilestone and !row.isParent"
                                  class="o_gs_bar"
                                  t-att-x="barGeoForRender(row).x + dragOffsetForBar(row)"
                                  t-att-y="row.y"
                                  t-att-width="barGeoForRender(row).width"
                                  t-att-height="row.height"
                                  rx="6" ry="6"
                                  t-att-fill="row.color"/>

                            <!-- Sprint 3.3: summary bar para padres WBS.
                                 Es una franja delgada negra/oscura con
                                 "puntas" en los extremos a lo MS Project. -->
                            <g t-if="!row.isMilestone and row.isParent">
                                <rect class="o_gs_bar_summary"
                                      t-att-x="barGeoForRender(row).x"
                                      t-att-y="row.y + row.height / 2 - 4"
                                      t-att-width="barGeoForRender(row).width"
                                      t-att-height="8"
                                      t-att-fill="row.color"/>
                                <!-- "Capucha" en el extremo izquierdo -->
                                <polygon class="o_gs_bar_summary_cap"
                                         t-att-points="
                                            (barGeoForRender(row).x) + ',' + (row.y + row.height / 2 - 4) + ' '
                                          + (barGeoForRender(row).x + 6) + ',' + (row.y + row.height / 2 - 4) + ' '
                                          + (barGeoForRender(row).x) + ',' + (row.y + row.height / 2 + 4)
                                         "
                                         t-att-fill="row.color"/>
                                <!-- "Capucha" en el extremo derecho -->
                                <polygon class="o_gs_bar_summary_cap"
                                         t-att-points="
                                            (barGeoForRender(row).x + barGeoForRender(row).width) + ',' + (row.y + row.height / 2 - 4) + ' '
                                          + (barGeoForRender(row).x + barGeoForRender(row).width - 6) + ',' + (row.y + row.height / 2 - 4) + ' '
                                          + (barGeoForRender(row).x + barGeoForRender(row).width) + ',' + (row.y + row.height / 2 + 4)
                                         "
                                         t-att-fill="row.color"/>
                            </g>
                            <rect t-if="!row.isMilestone and !row.isParent and row.progress !== null"
                                  class="o_gs_bar_progress"
                                  t-att-x="barGeoForRender(row).x + dragOffsetForBar(row)"
                                  t-att-y="row.y"
                                  t-att-width="barGeoForRender(row).width * row.progress / 100"
                                  t-att-height="row.height"
                                  rx="6" ry="6"/>
                            <text t-if="!row.isMilestone and !row.isParent and state.editingId !== row.record.id"
                                  t-att-class="row.labelOutside ? 'o_gs_bar_label o_gs_bar_label_outside' : 'o_gs_bar_label'"
                                  t-att-x="row.labelX + dragOffsetForBar(row)"
                                  t-att-y="row.labelY"
                                  t-esc="row.displayLabel"/>
                            <!-- Sprint 3.3: label de padre va FUERA del bar
                                 (a la derecha) porque el summary bar es muy
                                 delgado y el texto no entraría dentro. -->
                            <text t-if="row.isParent and state.editingId !== row.record.id"
                                  class="o_gs_bar_label o_gs_bar_label_outside o_gs_bar_summary_label"
                                  t-att-x="barGeoForRender(row).x + barGeoForRender(row).width + 8"
                                  t-att-y="row.y + row.height / 2"
                                  t-esc="row.label"/>

                            <!-- Sprint 3.2.B: edición inline.
                                 Cuando state.editingId apunta a este record,
                                 reemplazamos el <text> SVG por un <input> HTML
                                 inserted via <foreignObject>. Enter guarda,
                                 Esc cancela, blur también guarda. -->
                            <foreignObject t-if="!row.isMilestone and state.editingId === row.record.id"
                                           t-att-x="barGeoForRender(row).x + dragOffsetForBar(row) + 2"
                                           t-att-y="row.y + 2"
                                           t-att-width="barGeoForRender(row).width - 4"
                                           t-att-height="row.height - 4">
                                <input type="text"
                                       class="o_gs_inline_edit_input"
                                       t-att-data-record-id="row.record.id"
                                       t-att-value="state.editingValue"
                                       t-on-input="(ev) => this.onInlineEditInput(ev)"
                                       t-on-keydown="(ev) => this.onInlineEditKeyDown(row, ev)"
                                       t-on-blur="() => this.onInlineEditBlur(row)"
                                       t-on-mousedown.stop=""
                                       t-on-click.stop=""/>
                            </foreignObject>

                            <!-- Sprint 3.2.A: resize handles a left + right
                                 del bar. Solo se rendean si:
                                  - el controller pasó onBarResize (feature
                                    enabled);
                                  - la barra NO es milestone (no tiene duración);
                                  - la barra NO está bloqueada por
                                    disable_drag_drop;
                                  - hay ancho suficiente para que dos asas no
                                    se solapen visualmente (width > 20px).
                                 stopPropagation en el mousedown evita que el
                                 drag-de-bar entero se dispare al asir el asa. -->
                            <g t-if="!row.isMilestone and !row.dragDisabled and props.onBarResize and row.width > 20">
                                <rect class="o_gs_bar_resize_handle o_gs_bar_resize_left"
                                      t-att-x="barGeoForRender(row).x + dragOffsetForBar(row)"
                                      t-att-y="row.y"
                                      t-att-width="resizeHandleW"
                                      t-att-height="row.height"
                                      t-on-mousedown="(ev) => this.onResizeMouseDown(row, 'left', ev)"
                                      t-on-touchstart="(ev) => this.onResizeTouchStart(row, 'left', ev)"/>
                                <rect class="o_gs_bar_resize_handle o_gs_bar_resize_right"
                                      t-att-x="barGeoForRender(row).x + dragOffsetForBar(row) + barGeoForRender(row).width - resizeHandleW"
                                      t-att-y="row.y"
                                      t-att-width="resizeHandleW"
                                      t-att-height="row.height"
                                      t-on-mousedown="(ev) => this.onResizeMouseDown(row, 'right', ev)"
                                      t-on-touchstart="(ev) => this.onResizeTouchStart(row, 'right', ev)"/>
                            </g>

                            <!-- Sprint 3.2.C: dep creation handles "+" en los
                                 extremos del bar. Aparecen en hover (CSS).
                                 mousedown inicia el dibujo de una dep tipada;
                                 mouseup sobre otro bar abre popover. -->
                            <g t-if="!row.dragDisabled and props.onDepCreate"
                               class="o_gs_dep_handles">
                                <circle class="o_gs_dep_handle o_gs_dep_handle_left"
                                        t-att-cx="barGeoForRender(row).x + dragOffsetForBar(row)"
                                        t-att-cy="row.y + row.height / 2"
                                        r="5"
                                        t-on-mousedown="(ev) => this.onDepHandleMouseDown(row, 'left', ev)"/>
                                <circle class="o_gs_dep_handle o_gs_dep_handle_right"
                                        t-att-cx="barGeoForRender(row).x + dragOffsetForBar(row) + barGeoForRender(row).width"
                                        t-att-cy="row.y + row.height / 2"
                                        r="5"
                                        t-on-mousedown="(ev) => this.onDepHandleMouseDown(row, 'right', ev)"/>
                            </g>

                            <title t-esc="row.label"/>
                        </g>
                    </g>
                </g>
            </svg>

            <!-- Sprint 3.4 — Histograma de carga de recursos.
                 Aparece SOLO si el controller pasó props.resourceHistogram
                 (el user activó el botón). Se muestra después del SVG
                 principal, dentro del mismo scroll horizontal para que las
                 barras del histograma queden alineadas a los buckets del
                 timeline. -->
            <div t-if="props.resourceHistogram and props.resourceHistogram.resources.length"
                 class="o_gs_resource_histogram"
                 t-attf-style="width: {{viewportWidth}}px;">
                <div class="o_gs_resource_histogram_header">
                    <i class="fa fa-users me-2"/>
                    <strong>Carga de recursos</strong>
                    <small class="ms-2 text-muted">
                        (período: <t t-esc="props.resourceHistogram.period"/>)
                    </small>
                </div>
                <div t-foreach="props.resourceHistogram.resources" t-as="res"
                     t-key="res.id" class="o_gs_resource_row">
                    <div class="o_gs_resource_label" t-esc="res.label"/>
                    <div class="o_gs_resource_bars">
                        <div t-foreach="res.data" t-as="cell" t-key="cell_index"
                             class="o_gs_resource_cell"
                             t-att-class="cell.ratio > 1.0 ? 'o_gs_overallocated'
                                          : (cell.ratio > 0.8 ? 'o_gs_high_load'
                                          : (cell.ratio > 0 ? 'o_gs_normal_load' : ''))"
                             t-att-title="cell.allocated + 'h / ' + cell.capacity + 'h (' + Math.round(cell.ratio * 100) + '%)'"
                             t-attf-style="height: {{Math.min(100, cell.ratio * 100)}}%;"/>
                    </div>
                </div>
            </div>

            <!-- Sprint 3.2.C: popover de creación de dependencia.
                 Aparece donde el user soltó el drag (state.depPopover.x/y).
                 HTML standard (no foreignObject) porque vive fuera del SVG. -->
            <div t-if="state.depPopover" class="o_gs_dep_popover"
                 t-attf-style="left: {{state.depPopover.x}}px; top: {{state.depPopover.y}}px;">
                <div class="o_gs_dep_popover_arrow"/>
                <div class="o_gs_dep_popover_title">
                    <i class="fa fa-link me-2"/>
                    <strong>Nueva dependencia</strong>
                </div>
                <div class="o_gs_dep_popover_body">
                    <label>Tipo:</label>
                    <select t-on-change="(ev) => this.onDepPopoverTypeChange(ev)"
                            t-att-value="state.depPopover.depType">
                        <option value="FS">Fin → Inicio (FS)</option>
                        <option value="SS">Inicio → Inicio (SS)</option>
                        <option value="FF">Fin → Fin (FF)</option>
                        <option value="SF">Inicio → Fin (SF)</option>
                    </select>
                    <label class="mt-2">Lag (días):</label>
                    <input type="number" step="0.5"
                           t-att-value="state.depPopover.lagDays"
                           t-on-input="(ev) => this.onDepPopoverLagChange(ev)"/>
                </div>
                <div class="o_gs_dep_popover_actions">
                    <button class="btn btn-sm btn-light"
                            t-on-click="() => this.onDepPopoverCancel()">Cancelar</button>
                    <button class="btn btn-sm btn-primary"
                            t-on-click="() => this.onDepPopoverConfirm()">Crear</button>
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
