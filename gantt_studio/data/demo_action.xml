<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_project_task_gantt_studio_demo" model="ir.actions.act_window">
        <field name="name">Tasks (Gantt Studio)</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">gantt_studio,list,form</field>
        <field name="view_id" ref="view_project_task_gantt_studio_demo"/>
        <field name="context">{}</field>
        <field name="domain">[
            ('planned_date_begin', '!=', False),
            ('date_deadline', '!=', False),
        ]</field>
    </record>

    <menuitem id="menu_gantt_studio_demo"
              name="Gantt Studio Demo"
              parent="project.menu_main_pm"
              action="action_project_task_gantt_studio_demo"
              sequence="100"/>

</odoo>
