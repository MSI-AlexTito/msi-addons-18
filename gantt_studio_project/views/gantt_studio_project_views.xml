<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Vista <gantt_studio> sobre `project.task`.

        Es un EJEMPLO listo para usar. La vista vive en el módulo de
        integración (`gantt_studio_project`), no en el core, porque el core
        no depende de `project` — eso permite usar el mismo `gantt_studio`
        en CRM, ventas, manufactura, etc. sin ningún acople.

        Para escribir tu propia vista sobre cualquier modelo basta con:

            <gantt_studio date_start="campo_inicio"
                          date_stop="campo_fin"
                          default_scale="week"
                          default_group_by="campo_groupby"
                          color_field="campo_color">
                <field name="..."/>
            </gantt_studio>

        El core valida el arch y carga el renderer OWL automáticamente.
    -->
    <record id="view_project_task_gantt_studio_demo" model="ir.ui.view">
        <field name="name">project.task.gantt.studio.demo</field>
        <field name="model">project.task</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!--
                Atributos Sprint 3.1 ─ todos usan SOLO campos nativos de
                project.task en Odoo 18 Community (sin Enterprise):

                date_start / date_stop:
                    planned_date_begin existe únicamente con project_enterprise.
                    Para Community puro, ese atributo se reemplaza por
                    `date_assign` (readonly nativo). Aquí lo dejamos en
                    `planned_date_begin` para que la demo aproveche
                    Enterprise si está disponible, pero el módulo NO lo
                    requiere — cualquier vista personalizada puede usar otro
                    par de fechas.

                decoration-success="state in ('1_done',)"
                    state es un Selection nativo Community con valores
                    01_in_progress / 02_changes_requested / 03_approved /
                    1_done / 1_canceled / 04_waiting_normal.

                decoration-danger="date_deadline and date_deadline &lt; context_today()"
                    Tareas vencidas (deadline en el pasado y no cerradas).
                    `context_today()` es función nativa de py_js.

                decoration-warning="priority == '1'"
                    Tareas marcadas con prioridad alta (estrella).

                disable_drag_drop="is_closed"
                    is_closed es un campo computed nativo Community
                    (True si state in ('1_done', '1_canceled')).
                    Las tareas cerradas no se pueden arrastrar.

                milestone_field="milestone_id"
                    milestone_id es Many2one nativo Community a
                    project.milestone (truthy → diamond). Si no usas
                    milestones, simplemente no apuntará a nada.
            -->
            <gantt_studio date_start="planned_date_begin"
                          date_stop="date_deadline"
                          default_scale="week"
                          color_field="user_ids"
                          bar_text="name"
                          string="Gantt Studio (Tareas)"
                          decoration-success="state == '1_done'"
                          decoration-danger="date_deadline and date_deadline &lt; context_today()"
                          decoration-warning="priority == '1'"
                          decoration-muted="state == '1_canceled'"
                          disable_drag_drop="is_closed"
                          milestone_field="milestone_id"
                          parent_field="parent_id">
                <!--
                    Sprint 3.3 — WBS: parent_field="parent_id" usa el campo
                    nativo Many2one auto-referencial de project.task. Las
                    tareas con parent_id apuntando a otra tarea se renderean
                    indentadas como hijos, y el padre se muestra como
                    "summary bar" envolvente del rango de sus descendientes.
                    Click sobre el chevron de la izquierda colapsa/expande.
                    Nota: quitamos default_group_by ahora que el árbol WBS
                    da la estructura natural. Si querés agrupar igualmente,
                    usá el menú Agrupar por en el search panel.
                -->
                <field name="name"/>
                <field name="user_ids"/>
                <field name="stage_id"/>
                <field name="project_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="is_closed"/>
                <field name="milestone_id"/>
                <field name="parent_id"/>
            </gantt_studio>
        </field>
    </record>

</odoo>
